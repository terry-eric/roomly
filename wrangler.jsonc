{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "roomly",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "compatibility_flags": ["nodejs_compat"],
  "observability": {"enabled": true},
  "vars": {
    "APP_ORIGIN": "https://roomly.example.com",
    "GOOGLE_CLIENT_ID": "YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com",
    "GOOGLE_LOGIN_REDIRECT": "true",
    "ADMIN_EMAIL": "admin@example.com",
    "MAIL_FROM": "roomly@example.com"
  },
  "d1_databases": [{"binding":"DB","database_name":"roomly-access","database_id":"00000000-0000-0000-0000-000000000000"}],
  "triggers": {"crons":["* * * * *"]},
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": true,
    "directory": "./dist",
    "html_handling": "none",
    "not_found_handling": "none"
  }
}
