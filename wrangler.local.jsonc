{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "roomly-local",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "dev": {"ip": "localhost", "port": 3000, "local_protocol": "http"},
  "vars": {
    "APP_ORIGIN": "http://localhost:3000",
    "GOOGLE_CLIENT_ID": "YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com",
    "GOOGLE_LOGIN_REDIRECT": "true",
    "ADMIN_EMAIL": "admin@example.com",
    "MAIL_FROM": "roomly@example.com"
  },
  "d1_databases": [{"binding": "DB", "database_name": "roomly-access", "database_id": "00000000-0000-0000-0000-000000000000"}],
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": true,
    "directory": "./dist",
    "html_handling": "none",
    "not_found_handling": "none"
  }
}
