{
  "name": "roomly-community",
  "main": "src/community/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": {"enabled": false},
  "vars": {
    "PUBLIC_APP_ORIGIN": "https://roomly.example.com",
    "GOOGLE_CLIENT_ID": "YOUR_CLIENT_ID.apps.googleusercontent.com"
  },
  "assets": {"directory": "./community-dist", "binding": "ASSETS", "run_worker_first": true, "html_handling": "none", "not_found_handling": "none"},
  "d1_databases": [{"binding": "PUBLIC_DB", "database_name": "roomly-community", "database_id": "YOUR_D1_DATABASE_ID", "migrations_dir": "migrations-community"}],
  "queues": {
    "producers": [{"binding": "PUBLIC_SYNC_QUEUE", "queue": "roomly-community-sync"}],
    "consumers": [{"queue": "roomly-community-sync", "max_batch_size": 1, "max_batch_timeout": 1, "max_concurrency": 1, "max_retries": 6, "retry_delay": 30}]
  },
  "triggers": {"crons": []}
}
